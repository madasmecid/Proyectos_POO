<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="10.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/21" fx:controller="com.example.fichamedica.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label text="Ingreso de Paciente" style="-fx-font-weight: bold;" />

    <TextField fx:id="txtRut" promptText="RUT (ej: 12345678-9)" />
    <TextField fx:id="txtNombre" promptText="Nombre completo" />
    <TextField fx:id="txtEdad" promptText="Edad" />
    <TextField fx:id="txtPeso" promptText="Peso (kg)" />

    <Button text="Guardar Ficha" onAction="#onGuardarClick" maxWidth="Infinity" />

    <Label text="Consulta" style="-fx-font-weight: bold;">
        <VBox.margin>
            <Insets top="15.0" />
        </VBox.margin>
    </Label>

    <TextField fx:id="txtBuscarRut" promptText="Buscar por RUT" />
    <Button text="Buscar" onAction="#onBuscarClick" maxWidth="Infinity" />

    <Label fx:id="lblEstado" text="Esperando datos..." textFill="#0055aa" wrapText="true">
        <VBox.margin>
            <Insets top="10.0" />
        </VBox.margin>
    </Label>
</VBox>