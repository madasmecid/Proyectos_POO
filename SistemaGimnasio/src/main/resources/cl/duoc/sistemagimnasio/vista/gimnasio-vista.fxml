<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cl.duoc.sistemagimnasio.control.GimnasioControl">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <!-- Título principal -->
    <Label text="Gestión de Socios - Fitness Life">
        <font>
            <Font name="System Bold" size="18.0" />
        </font>
    </Label>

    <!-- Formulario Entradas de Texto -->
    <HBox alignment="CENTER" spacing="10.0">
        <TextField fx:id="txtRut" promptText="RUT (ej: 12345678-9)" HBox.hgrow="ALWAYS" />
        <TextField fx:id="txtNombre" promptText="Nombre completo" HBox.hgrow="ALWAYS" />
        <Label fx:id="lblDetalle" text="Detalle:" />
        <TextField fx:id="txtDetalle" promptText="Ingrese detalle" HBox.hgrow="ALWAYS" />
    </HBox>

    <!-- Selección de Tipo y Botones de Acción -->
    <HBox alignment="CENTER" spacing="15.0">
        <ComboBox fx:id="cmbTipo" onAction="#cambiarTipo" prefWidth="150.0" />
        <Button onAction="#onClickGuardar" text="Guardar" />
        <Button onAction="#onClickEliminar" text="Eliminar" />
    </HBox>

    <!-- Tabla de Contenidos -->
    <TableView fx:id="tblSocios" prefHeight="250.0" prefWidth="550.0" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colRut" prefWidth="120.0" text="RUT" />
            <TableColumn fx:id="colNombre" prefWidth="160.0" text="Nombre" />
            <TableColumn fx:id="colCuota" prefWidth="130.0" text="Cuota Mensual" />
            <TableColumn fx:id="colDetalle" prefWidth="140.0" text="Detalle" />
        </columns>
    </TableView>

    <!-- Etiqueta de Mensaje para Feedback Visual -->
    <Label fx:id="lblMensaje" alignment="CENTER" prefHeight="20.0" textAlignment="CENTER">
        <font>
            <Font name="System Bold" size="13.0" />
        </font>
    </Label>

</VBox>