<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.gestorflotafx.HelloController">
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/>
    </padding>

    <!-- Título -->
    <Label text="Gestor de Flota de Vehículos" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <!-- Formulario -->
    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <ComboBox fx:id="cmbTipo" promptText="Tipo" prefWidth="120.0"/>
        <TextField fx:id="txtPatente" promptText="Patente" prefWidth="100.0"/>
        <TextField fx:id="txtMarca" promptText="Marca" prefWidth="120.0"/>
        <TextField fx:id="txtAnio" promptText="Año" prefWidth="80.0"/>
        <TextField fx:id="txtEspecifico" promptText="Puertas o Carga (kg)" prefWidth="140.0"/>
        <Button text="Guardar" onAction="#onGuardarClick" defaultButton="true"/>
    </HBox>

    <!-- Mensaje de estado/validación -->
    <Label fx:id="lblEstado" text="Listo para registrar vehículos." style="-fx-text-fill: #333333;"/>

    <!-- Tabla -->
    <TableView fx:id="tblVehiculos" prefHeight="250.0" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colPatente" text="Patente" prefWidth="100.0"/>
            <TableColumn fx:id="colMarca" text="Marca" prefWidth="120.0"/>
            <TableColumn fx:id="colAnio" text="Año" prefWidth="80.0"/>
            <TableColumn fx:id="colDetalle" text="Detalle Específico" prefWidth="250.0"/>
        </columns>
    </TableView>
</VBox>