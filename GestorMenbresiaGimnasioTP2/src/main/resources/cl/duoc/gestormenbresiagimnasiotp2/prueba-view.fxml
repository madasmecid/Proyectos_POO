<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_RIGHT" prefHeight="602.0" prefWidth="553.0" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cl.duoc.gestormenbresiagimnasiotp2.control.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <HBox prefHeight="85.0" prefWidth="531.0">
            <children>
                <TextField fx:id="txtRut" promptText="rut" />
                <TextField fx:id="txtNombre" promptText="nombre" />
                <Button mnemonicParsing="false" onAction="#onClickGuardar" prefHeight="25.0" prefWidth="101.0" text="Guardar" />
                <Button mnemonicParsing="false" onAction="#onClickEliminar" prefHeight="25.0" prefWidth="99.0" text="Eliminar" />
            </children></HBox>
        <HBox prefHeight="100.0" prefWidth="200.0">
            <children>
                <Label fx:id="lblDetalle" prefHeight="17.0" prefWidth="136.0" text="Dias con locker" />
                <ComboBox fx:id="cmbTipo" prefWidth="150.0" promptText="tipo Miembro" />
                <TextField fx:id="txtDetalle" prefHeight="25.0" prefWidth="203.0" />
            </children>
        </HBox>
        <BorderPane prefHeight="387.0" prefWidth="513.0">
            <top>
                <TableView fx:id="tabla" prefHeight="322.0" prefWidth="513.0" BorderPane.alignment="CENTER">
                    <columns>
                        <TableColumn fx:id="colRut" prefWidth="75.0" text="Rut" />
                        <TableColumn fx:id="colNombre" prefWidth="75.0" text="Nombre" />
                        <TableColumn fx:id="colCosto" prefWidth="75.0" text="Costo" />
                        <TableColumn fx:id="colDetalle" prefWidth="75.0" text="Detalle" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </top>
            <bottom>
                <Label fx:id="lblMensaje" contentDisplay="CENTER" prefHeight="17.0" prefWidth="212.0" BorderPane.alignment="CENTER" />
            </bottom>
        </BorderPane>
    </children>
</VBox>
