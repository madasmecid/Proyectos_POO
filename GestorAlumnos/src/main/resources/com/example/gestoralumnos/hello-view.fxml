<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="417.0" prefWidth="548.0" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.gestoralumnos.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <children>
      <HBox prefHeight="122.0" prefWidth="256.0">
         <children>
            <TextField fx:id="txtRut" promptText="RUT" />
            <TextField fx:id="txtNombre" promptText="NOMBRE" />
            <TextField fx:id="txtEdad" promptText="EDAD" />
            <Button fx:id="onGuardarClick" mnemonicParsing="false" onAction="#onGuardarClick" text="GUARDAR" />
         </children>
      </HBox>
      <TableView fx:id="tablaAlumnos" prefHeight="200.0" prefWidth="200.0">
        <columns>
          <TableColumn fx:id="colRut" prefWidth="75.0" text="RUT" />
          <TableColumn fx:id="colNombre" prefWidth="75.0" text="NOMBRE" />
            <TableColumn fx:id="colEdad" prefWidth="75.0" text="EDAD" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </children>
</VBox>
