<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cl.duoc.controlinventariofx.HelloController">
   <children>
      <HBox prefHeight="100.0" prefWidth="200.0">
         <children>
            <TextField fx:id="txtCodigo" promptText="codigo" />
            <TextField fx:id="txtNombre" promptText="nombre" />
            <TextField fx:id="txtStock" promptText="stock" />
            <Button mnemonicParsing="false" onAction="#onGuardarClick" text="Guardar" />
            <Button mnemonicParsing="false" onAction="#onEliminarClick" text="Eliminar" />
         </children>
      </HBox>
      <TableView fx:id="tablaProductos" prefHeight="200.0" prefWidth="200.0">
        <columns>
          <TableColumn fx:id="colCodigo" prefWidth="75.0" text="Codigo" />
          <TableColumn fx:id="colNombre" prefWidth="75.0" text="Nombre" />
            <TableColumn fx:id="colStock" prefWidth="75.0" text="Stock" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </children>
</VBox>
