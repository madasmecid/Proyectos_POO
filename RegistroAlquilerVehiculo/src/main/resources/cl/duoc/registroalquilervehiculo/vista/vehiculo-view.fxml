<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="505.0" prefWidth="801.0" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cl.duoc.registroalquilervehiculo.control.VehiculoControl">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <Label text="Registro De Vehiculos" textAlignment="CENTER">
      <font>
         <Font name="Dubai Bold" size="32.0" />
      </font>
   </Label>
   <HBox alignment="CENTER" prefHeight="68.0" prefWidth="761.0">
      <children>
         <TextField fx:id="txtPatente" promptText="Patente" />
         <TextField fx:id="txtMarca" promptText="Marca" />
         <ComboBox fx:id="cmbTipo"
                   prefWidth="150.0"
                   style ="-fx-background-color: #ffffff; -fx-border-color: #ced4da; -fx-border-radius: 4;-fx-font-weight: bold"
                   promptText="Tipo Vehiculo" />
      </children>
   </HBox>

    <Label fx:id="welcomeText" />
   <HBox alignment="TOP_CENTER" prefHeight="100.0" prefWidth="200.0">
      <children>
         <Label fx:id="lblDetalle" prefHeight="17.0" prefWidth="157.0" text="N° Pasajeros" />
         <TextField fx:id="txtDetalle" prefHeight="25.0" prefWidth="170.0" promptText="Ej: 5" />
         <Button mnemonicParsing="false" onAction="#onClickGuardar" prefHeight="25.0" prefWidth="101.0" style="-fx-base: #d4edda; -fx-text-fill: #155724; -fx-font-weight: bold"  text="Guardar"  />
         <Button mnemonicParsing="false" onAction="#onClickEliminar" prefHeight="25.0" prefWidth="99.0" style="-fx-base: #ffcccc; -fx-text-fill: #990000; -fx-font-weight: bold" text="Eliminar" />
      </children>
   </HBox>
   <BorderPane prefHeight="197.0" prefWidth="761.0">
      <top>
         <TableView fx:id="tabla"
                    prefHeight="200.0"
                    prefWidth="600.0"
                    style="fx-header-background-color: #f8f9fa; -fx-selection-bar: #e2e6ea; -fx-selection-bar-non-focused: #f1f3f5"
                    BorderPane.alignment="CENTER">
           <columns>
             <TableColumn fx:id="colPatente" prefWidth="75.0" text="Patente" />
             <TableColumn fx:id="colMarca" prefWidth="75.0" text="Marca" />
               <TableColumn fx:id="colCosto" prefWidth="75.0" text="Costo diario" />
               <TableColumn fx:id="colDetalle" prefWidth="75.0" text="Detalle" />
           </columns>
            <columnResizePolicy>
               <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
         </TableView>
      </top>
   </BorderPane>
   <Label fx:id="lblMensaje" prefHeight="17.0" prefWidth="199.0" textAlignment="CENTER" />
</VBox>
