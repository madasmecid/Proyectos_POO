<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" prefHeight="410.0" prefWidth="549.0" spacing="20.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/26" fx:controller="cl.duoc.sistemaalojamiento.control.AlojamientoControl">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <HBox prefHeight="108.0" prefWidth="509.0">
      <children>
         <TextField fx:id="txtCodigo" promptText="Codigo" />
         <TextField fx:id="txtNombre" promptText="Nombre" />
         <Label fx:id="lblDetalle" contentDisplay="RIGHT" prefHeight="17.0" prefWidth="82.0" text="Es vip ?" textAlignment="CENTER" />
         <TextField fx:id="txtDetalle" />
      </children>
   </HBox>

    <Label fx:id="welcomeText" />
   <HBox alignment="TOP_CENTER" prefHeight="100.0" prefWidth="200.0">
      <children>
         <ComboBox fx:id="cmbTipo" prefWidth="150.0" promptText="Tipo" />
         <Button mnemonicParsing="false" onAction="#onClickGuardar" text="Guardar" />
         <Button mnemonicParsing="false" onAction="#onClickEliminar" text="Eliminar" />
      </children>
   </HBox>
   <BorderPane prefHeight="200.0" prefWidth="200.0">
      <center>
         <TableView fx:id="tabla" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
           <columns>
             <TableColumn fx:id="colCodigo" prefWidth="75.0" text="Codigo" />
             <TableColumn fx:id="colNombre" prefWidth="75.0" text="Nombre" />
               <TableColumn fx:id="colPrecio" prefWidth="75.0" text="Precio" />
               <TableColumn fx:id="colDetalle" prefWidth="75.0" text="Detalles" />
           </columns>
            <columnResizePolicy>
               <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
         </TableView>
      </center>
   </BorderPane>
   <Label fx:id="lblMensaje" />
</VBox>
