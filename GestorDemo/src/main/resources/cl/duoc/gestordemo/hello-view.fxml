<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cl.duoc.gestordemo.HelloController">
   <children>
      <HBox prefHeight="100.0" prefWidth="200.0">
         <children>
            <TextField fx:id="txtMarca" promptText="Marca de la bici" />
            <TextField fx:id="txtTipo" promptText="tipo de bici" />
            <Button mnemonicParsing="false" onAction="#onGuardarClick" text="Guardar" />
         </children>
      </HBox>
      <TableView fx:id="tablaBicicleca" prefHeight="200.0" prefWidth="200.0">
        <columns>
          <TableColumn fx:id="colMarca" prefWidth="75.0" text="marca" />
          <TableColumn fx:id="colTipo" prefWidth="75.0" text="tipo" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </children>
</VBox>
