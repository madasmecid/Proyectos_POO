<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="543.0" prefWidth="741.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cl.duoc.gestormascotasfx.HelloController">
   <children>
      <HBox prefHeight="100.0" prefWidth="200.0" spacing="10.0">
         <children>
            <TextField fx:id="txtChip" promptText="Numero Chip" />
            <TextField fx:id="txtNombre" promptText="Nombre" />
            <TextField fx:id="txtPeso" promptText="Peso" />
            <Button mnemonicParsing="false" onAction="#onGuardarClick" text="Guardar" />
            <Button mnemonicParsing="false" onAction="#onEliminarClick" text="Eliminar" />
            <Button mnemonicParsing="false" onAction="#onActualizarClick" text="Actualizar" />
         </children>
         <padding>
            <Insets left="10.0" />
         </padding>
      </HBox>
      <BorderPane prefHeight="200.0" prefWidth="200.0">
         <bottom>
            <ComboBox fx:id="cmbTipo" prefWidth="150.0" promptText="tipo mascota" BorderPane.alignment="CENTER" />
         </bottom>
      </BorderPane>
      <TableView fx:id="tablaMascotas" minHeight="-Infinity" minWidth="-Infinity" prefWidth="741.0">
        <columns>
          <TableColumn fx:id="colChip" prefWidth="75.0" text="Chip" />
          <TableColumn fx:id="colNombre" prefWidth="75.0" text="Nombre" />
            <TableColumn fx:id="colPeso" prefWidth="75.0" text="Peso" />
            <TableColumn fx:id="colTipo" prefWidth="75.0" text="Tipo" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </children>
</VBox>
